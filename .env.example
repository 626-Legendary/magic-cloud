APP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=
# Footer version (without v); rebuild the app after changing it.
APP_VERSION=1.0.1
# Set both values to enable HTTP access on the server LAN IP (e.g. 192.168.0.101).
LAN_BIND_ADDRESS=127.0.0.1
LAN_ORIGIN=http://127.0.0.1:5080
# Copy the complete value after --token in the Cloudflare connector install command.
# A Tunnel ID (UUID) is not a Tunnel Token.
CLOUDFLARE_TUNNEL_TOKEN=
# local: internal persistent directory; external: UUID-checked ext4 mount.
STORAGE_MODE=local
STORAGE_MOUNT=/srv/magic-cloud
# Required only for external mode.
STORAGE_UUID=
STORAGE_ID=replace-after-explicit-storage-initialization
APP_UID=10001
APP_GID=10001
SAFETY_MARGIN_BYTES=2147483648
SAFETY_MARGIN_PERCENT=5
PORT=5080
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7
